export HOMEBREW_BUNDLE_FILE="$HOME/.Brewfile"
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_ENV_HINTS=1
export PROMPT='%1~ %# '
export ZDOTDIR="${ZDOTDIR:-$HOME}"

[[ -f "$HOME/.host_role" ]] && source "$HOME/.host_role"
[[ "$HOMEBREW_HOST_ROLE" == "work" ]] && source "$HOME/.work.zshrc"

# Enable running `.pyrc` when the Py shell starts.
[[ -f "$HOME/.pyrc" ]] && export PYTHONSTARTUP="$HOME/.pyrc"

[[ -f "$ZDOTDIR/.zsh_aliases" ]] && source "$ZDOTDIR/.zsh_aliases"
[[ -f "$ZDOTDIR/.zsh_options" ]] && source "$ZDOTDIR/.zsh_options"
[[ -f "$ZDOTDIR/.py-auto-venv.zsh" ]] && source "$ZDOTDIR/.py-auto-venv.zsh"

eval "$(pyenv init - zsh)"
