(( $+commands[gawk] )) && alias awk=gawk
(( $+commands[simplelogin] )) && alias sl=simplelogin
(( $+commands[thefuck] )) && eval $(thefuck --alias)


if (( $+commands[eza] )); then
    # Requires eza (`brew install eza`)
    # Preferred for Git compatibility and a few others
    alias ls="eza \
        --oneline \
        --classify=always \
        --group-directories-first \
        --color=auto \
        --icons=never \
    "
elif (( $+commands[gls] )); then
    # Requires GNU CoreUtils (`brew install coreutils`)
    # Still better than macOS default ls, but requires manual hiding
    alias ls="gls \
         -1 \
        --file-type \
        --group-directories-first \
        --color=auto \
        --hide=__pycache__ \
    "
else
    alias ls='ls -1 -F --color=auto'
fi


# Simplify spell-checking directly from command line.
# Usage: spell word1[ word2[...]]
(( $+commands[hunspell] )) && spell() {
    echo "$*" | hunspell | awk -F ': ' '

        # Lines that start with `&` or `#` are spelling errors.
        /^(&|#)/ {
            split($1, parts, " ")

            misspelling = parts[2]
            corrections = $2
            print misspelling FS corrections
        }

    '
}


# Display the given manpage in TextEdit.
function mant() {
    man -w "$1" > /dev/null \
        && man "$1" | col -b | open -f
}
